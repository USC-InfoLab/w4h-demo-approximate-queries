# Copy to `.env` and fill in locally. Never commit `.env`.
# Direct Postgres connection — this demo queries Postgres directly, not the W4H API.

PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=w4h

# Dataset schema to read from (ds_<dataset_id>) and the signal/subject to demo against
W4H_DATASET_SCHEMA=ds_sample_fitbit_csv
W4H_SIGNAL_TABLE=fitbit_heart_rate
W4H_SUBJECT_ID=
